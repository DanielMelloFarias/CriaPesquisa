# Dependências
node_modules/

# Build
dist/
build/
*.tsbuildinfo

# Ambiente — ignora qualquer .env e reabre só os modelos.
# Regra ampla de propósito: .env.prod carrega senha do banco e JWT_SECRET, e
# listar variante por variante é como um arquivo desses acaba versionado.
.env
.env.*
!.env.example
!.env.*.example

# Testes / cobertura
coverage/

# Logs
*.log
npm-debug.log*

# Backups — contêm dados pessoais (respostas, IPs, hashes de senha). NUNCA versionar.
backups/
*.backup.json

# Planilhas — a de indicadores tem e-mails pessoais e o repositório é público (LGPD). NUNCA versionar.
*.xlsx
*.xls

# Documentos internos de gestão — não publicar no repositório
Executivo/

# Prisma (padrões com ** para casar em qualquer nível, ex.: backend/prisma/)
**/prisma/*.db
**/prisma/seed.js

# Scratch da orquestração (subagent-driven-development)
.superpowers/

# Sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Worktrees locais do Claude Code
.claude/worktrees/
