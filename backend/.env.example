PORT=3333

# Banco. Em dev local o script `npm run db` sobe um Postgres embutido na porta 5433.
DATABASE_URL=postgresql://cria_user:cria_senha@localhost:5433/criapesquisa?schema=public

# Segredo de assinatura dos tokens JWT.
# OBRIGATÓRIO quando NODE_ENV=production (a aplicação recusa subir sem ele).
# Fora de produção, cai num default local apenas para facilitar o setup.
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES=8h

# Senha inicial das contas criadas pelo seed (`npm run seed`).
# Nunca use aqui a senha real de ambientes institucionais.
SEED_PASSWORD=dev-criapesquisa

# Domínio dos e-mails das contas-base criadas pelo seed.
# Defina o domínio institucional real apenas no .env do ambiente (nunca no repositório).
SEED_EMAIL_DOMINIO=@exemplo.local

# Uma ou mais origens separadas por vírgula.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# De quem aceitar o X-Forwarded-For (proxies na frente da API: nginx, load balancer).
# Deixe vazio/ausente quando a API recebe as conexões diretamente: confiar no
# cabeçalho X-Forwarded-For sem proxy na frente permitiria forjar o IP de origem
# e escapar do limite de tentativas de login.
# Atrás de proxies em rede privada (contêineres), use uniquelocal — vale para um
# nginx só e para nginx + outro proxy na frente. Um número (1, 2) conta saltos.
TRUST_PROXY=
