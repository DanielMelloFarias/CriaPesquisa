generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  ADMIN
  GESTOR
  COLETADOR
  VISUALIZADOR
}

enum StatusPesquisa {
  RASCUNHO
  PUBLICADA
  ENCERRADA
  ARQUIVADA
}

enum StatusResposta {
  PENDENTE
  APROVADA
  REPROVADA
}

enum TipoPergunta {
  TEXTO
  NUMERO
  DATA
  MULTIPLA_ESCOLHA
  ESCOLHA_UNICA
  CAMPO_ABERTO
}

enum AcaoLog {
  CREATE
  UPDATE
  DELETE
  RESTORE
  PUBLICAR
  ENCERRAR
  ARQUIVAR
  APROVAR
  REPROVAR
}

enum TipoIndicador {
  PROPORCAO
  CRUZAMENTO
  MEDIA
  DERIVADA
  COMPOSTO
  CLASSIFICACAO
  CONTAGEM
  DISTRIBUICAO
  ESCALA
  META_POR_IDADE
  ZSCORE
  PERCENTIL_OMS
  ATALAH
}

enum StatusIndicador {
  ATIVO
  DEFINICAO_INCOMPLETA
  INATIVO
}

enum RecorteIndicador {
  ANTES_APOS
}

model Usuario {
  id        String       @id @default(uuid())
  nome      String
  email     String       @unique
  senhaHash String
  papel     PapelUsuario
  ativo     Boolean      @default(true)
  // Conta criada por um admin (ou pelo seed) nasce com senha que outra pessoa
  // conhece: até a troca, o acesso não identifica quem de fato agiu.
  precisaTrocarSenha Boolean @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pesquisasResponsavel Pesquisa[]        @relation("PesquisaResponsavel")
  pesquisasCriadas     Pesquisa[]        @relation("PesquisaCriadaPor")
  respostasColetadas   Resposta[]        @relation("RespostaColetadaPor")
  respostasRevisadas   Resposta[]        @relation("RespostaRevisadaPor")
  logs                 LogAlteracao[]
  versoes              PesquisaVersao[]
}

model MunicipioMensal {
  id                 Int    @id @default(autoincrement())
  ano                Int
  mes                Int
  mesNome            String
  municipio          String
  regional           String
  totalBeneficiarios Int
  criancas           Int
  gestantes          Int
  valorTotal         Float
  rendaMedia         Float

  @@unique([ano, mes, municipio])
  @@index([ano, mes])
  @@index([regional])
  @@index([municipio])
}

model BeneficioComposicao {
  id         Int    @id @default(autoincrement())
  ano        Int
  mes        Int
  label      String
  quantidade Int

  @@index([ano, mes])
}

model Pesquisa {
  id            String         @id @default(uuid())
  titulo        String
  descricao     String?
  responsavelId String
  status        StatusPesquisa @default(RASCUNHO)
  periodoInicio DateTime?      @db.Date
  periodoFim    DateTime?      @db.Date
  publicadaEm   DateTime?
  encerradaEm   DateTime?
  versaoAtual   Int            @default(1)
  createdById   String
  updatedById   String?
  deletedAt     DateTime?
  deletedById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  responsavel Usuario          @relation("PesquisaResponsavel", fields: [responsavelId], references: [id])
  createdBy   Usuario          @relation("PesquisaCriadaPor", fields: [createdById], references: [id])
  secoes      Secao[]
  perguntas   Pergunta[]
  respostas   Resposta[]
  versoes     PesquisaVersao[]
  indicadores Indicador[]

  @@index([status])
  @@index([responsavelId])
  @@index([deletedAt])
}

model Secao {
  id         String  @id @default(uuid())
  pesquisaId String
  titulo     String
  descricao  String?
  ordem      Int

  pesquisa  Pesquisa   @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  perguntas Pergunta[]

  @@index([pesquisaId, ordem])
}

model Pergunta {
  id          String       @id @default(uuid())
  pesquisaId  String
  secaoId     String?
  enunciado   String
  tipo        TipoPergunta
  obrigatoria Boolean      @default(false)
  ordem       Int
  ajuda       String?

  pesquisa Pesquisa        @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  secao    Secao?          @relation(fields: [secaoId], references: [id])
  opcoes   OpcaoPergunta[]
  itens    ItemResposta[]

  @@index([pesquisaId, ordem])
}

model OpcaoPergunta {
  id         String @id @default(uuid())
  perguntaId String
  texto      String
  ordem      Int

  pergunta Pergunta @relation(fields: [perguntaId], references: [id], onDelete: Cascade)

  @@index([perguntaId, ordem])
}

model Resposta {
  id           String         @id @default(uuid())
  pesquisaId   String
  coletadorId  String
  municipio    String?
  unidade      String?
  regional     String?
  status       StatusResposta @default(PENDENTE)
  observacao   String?
  revisadoPorId String?
  revisadoEm   DateTime?
  enviadaEm    DateTime       @default(now())
  ip           String?
  deletedAt    DateTime?
  deletedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  pesquisa    Pesquisa       @relation(fields: [pesquisaId], references: [id])
  coletador   Usuario        @relation("RespostaColetadaPor", fields: [coletadorId], references: [id])
  revisadoPor Usuario?       @relation("RespostaRevisadaPor", fields: [revisadoPorId], references: [id])
  itens       ItemResposta[]

  @@index([pesquisaId])
  @@index([municipio])
  @@index([enviadaEm])
  @@index([deletedAt])
  @@index([status])
}

model ItemResposta {
  id                 String    @id @default(uuid())
  respostaId         String
  perguntaId         String
  valorTexto         String?
  valorNumero        Float?
  valorData          DateTime? @db.Date
  opcoesSelecionadas String[]

  resposta Resposta @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  pergunta Pergunta @relation(fields: [perguntaId], references: [id])

  @@index([respostaId])
  @@index([perguntaId])
}

model LogAlteracao {
  id          String   @id @default(uuid())
  entidade    String
  entidadeId  String
  acao        AcaoLog
  usuarioId   String
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  createdAt   DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([entidade, entidadeId])
  @@index([usuarioId])
  @@index([createdAt])
}

model PesquisaVersao {
  id           String   @id @default(uuid())
  pesquisaId   String
  versao       Int
  snapshot     Json
  usuarioId    String
  createdAt    DateTime @default(now())

  pesquisa Pesquisa @relation(fields: [pesquisaId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([pesquisaId, versao])
}

model Indicador {
  id             String            @id @default(uuid())
  codigo         String            @unique
  nome           String
  objetivo       String?
  tipo           TipoIndicador
  unidade        String?
  casasDecimais  Int               @default(1)
  pesquisaId     String?
  config         Json
  recorte        RecorteIndicador?
  recorteConfig  Json?
  meta           Float?
  formulaOriginal String?
  status         StatusIndicador   @default(DEFINICAO_INCOMPLETA)
  motivoIncompleto String?
  origemPlanilha Int?
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?
  deletedById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  pesquisa     Pesquisa?              @relation(fields: [pesquisaId], references: [id])
  dependeDe    IndicadorDependencia[] @relation("IndicadorOrigem")
  usadoPor     IndicadorDependencia[] @relation("IndicadorDestino")

  @@index([status])
  @@index([pesquisaId])
  @@index([deletedAt])
}

model IndicadorDependencia {
  indicadorId String
  dependeDeId String

  indicador Indicador @relation("IndicadorOrigem", fields: [indicadorId], references: [id], onDelete: Cascade)
  dependeDe Indicador @relation("IndicadorDestino", fields: [dependeDeId], references: [id])

  @@id([indicadorId, dependeDeId])
  @@index([dependeDeId])
}
